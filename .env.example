# Pick one provider.
# Amazon Bedrock (counts for the AWS Builder mini challenge): uses your AWS credentials chain.
FORGE_PROVIDER=bedrock
AWS_REGION=us-east-1
# Or the Claude API:
# FORGE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# docker (default, isolated container per run) or process (dev fallback)
FORGE_SANDBOX=docker
PORT=8787

# Free local development (no Claude): a local model via Ollama, or a canned replay.
# FORGE_PROVIDER=ollama
# FORGE_MODEL=qwen2.5-coder:7b   # guided smith: 12/12 on scripts/forge-bench.ts (one run)
# FORGE_PROVIDER=mock
